# ---- Stayra configuration ----------------------------------------------------
# Copy to .env and adjust. `docker compose up --build` reads this file.

# Runtime environment. "Development" enables the "Simulate payment" button,
# the Zalo simulator and the Hangfire dashboard at /hangfire.
ASPNETCORE_ENVIRONMENT=Development

# Database
POSTGRES_PASSWORD=stayra
POSTGRES_PORT=5432

# Signing key for owner/admin JWTs (32+ characters). Change in production.
JWT_KEY=change-me-to-a-long-random-string-0123456789

# Where the web app is served (used for CORS, redirects and links in messages)
WEB_BASE_URL=http://localhost:5173
# Public URL of the API (VNPay IPN + Zalo webhook). Use your ngrok URL to receive callbacks.
PUBLIC_API_URL=http://localhost:8080

# ---- AI concierge (Anthropic Claude) ----
# Without a key the concierge answers with a limited offline assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Embeddings for policy search (Voyage AI, voyage-3, 1024 dims) ----
# Without a key, policy search falls back to Postgres full-text search.
VOYAGE_API_KEY=

# ---- VNPay Sandbox (https://sandbox.vnpayment.vn/devreg) ----
# Register a sandbox terminal at sandbox.vnpayment.vn/devreg and fill in TmnCode + HashSecret.
# Tenants can override these with their own keys via Settings → Payments.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Set to true to disable VNPay URL generation (payment cards then rely on "Simulate payment").
VNPAY_OFFLINE=false

# ---- Email notifications (SMTP / Gmail App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Stayra
SMTP_ENABLE_SSL=true

# ---- Optional: SMTP for booking confirmation emails ----
# Without SMTP_HOST, confirmation emails are written to API logs ([Email stub]).
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Stayra

# ---- Optional: ngrok tunnel (docker compose --profile tunnel up) ----
NGROK_AUTHTOKEN=

# ---- Deplao T123 (Multi-channel Gateway: Zalo, Facebook, Telegram) ----
# Only DEPLAO_WEB_PASSWORD is required; per-tenant API keys & webhooks are auto-provisioned.
DEPLAO_WEB_PASSWORD=stayra-deplao-local-1234
